# Enigma OS minimal live package list
# Per SPEC §3 (stripped KDE Plasma), §1 (CachyOS base), §2 (GPU/drivers deferred to Phase 3)

# Base system
base
linux-cachyos
linux-lts
linux-firmware

# CachyOS base
cachyos-keyring
cachyos-mirrorlist

# Init & boot (systemd-boot ships inside systemd; GRUB fallback per SPEC §1)
systemd
grub
syslinux

# Filesystem & storage
btrfs-progs
parted
gptfdisk
partclone

# Networking
networkmanager
wpa_supplicant
dhclient

# Shell & utilities
bash
zsh
sudo
vim
nano
git
curl
wget
htop
tmux
which

# Desktop (KDE Plasma 6 Wayland, stripped per SPEC §3)
# plasma-workspace provides the Wayland session; kirigami/syntax-highlighting
# are the KF6 packages (unprefixed in Arch's repos).
plasma-desktop
plasma-workspace
kirigami
syntax-highlighting

# KDE minimal base
dolphin
konsole
kate
gwenview
vlc

# Audio & media
pipewire
pipewire-alsa
pipewire-jack
wireplumber

# Display manager
sddm
sddm-kcm

# Common dev tools
base-devel
gcc
make
cmake
pkgconf

# Fonts per SPEC §3
adobe-source-code-pro-fonts
inter-font
ttf-jetbrains-mono-nerd
noto-fonts
noto-fonts-cjk
noto-fonts-emoji

# Security & firewall
nftables
apparmor

# Power management
tlp
tlp-rdw

# Device management (udev ships inside systemd)
udisks2

# Docker / container support (minimal, Phase 7 extends)
podman
podman-docker

# Miscellaneous
efibootmgr
lsb-release
lshw
pciutils
usbutils

# Installer & first-boot (Phase 2) — CachyOS-branded Calamares
cachyos-calamares
mkinitcpio-archiso
mkinitcpio

# Btrfs snapshots & rollback (Phase 2, SPEC §7)
snapper
snap-pac
grub-btrfs
os-prober

# Additional utilities
rsync
gnupg
openssh
